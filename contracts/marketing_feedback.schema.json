{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marketing_feedback.schema.json",
  "title": "Marketing Agent Feedback to Strategy Agent",
  "type": "object",
  "required": ["campaign_id", "oneid", "channel", "event_type", "event_time"],
  "properties": {
    "campaign_id": {"type": "string"},
    "oneid": {"type": "string"},
    "channel": {"type": "string"},
    "event_type": {
      "type": "string",
      "enum": ["view_detail", "ignored", "unsubscribed"]
    },
    "event_time": {"type": "string", "format": "date-time"},
    "feedback_metrics": {
      "type": "object",
      "properties": {
        "exposure_count": {"type": "integer"},
        "detail_view_count": {"type": "integer"},
        "ignored_count": {"type": "integer"},
        "unsubscribe_count": {"type": "integer"},
        "conversion_count": {"type": "integer"},
        "complaint_count": {"type": "integer"},
        "cost": {"type": "number"},
        "revenue": {"type": "number"},
        "roi": {"type": "number"}
      }
    },
    "channel_attribution": {"type": "array", "items": {"type": "object"}},
    "segment_performance": {"type": "array", "items": {"type": "object"}},
    "conversation_outcome": {"type": "object"}
  }
}
