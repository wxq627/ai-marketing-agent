STRATEGY_MOCK_FILE=./contracts/examples/strategy_package_example.json

KE_API_BASE=http://localhost:8000
KE_API_TIMEOUT=10
KE_FALLBACK_TO_MOCK=true

SA_API_BASE=http://localhost:8765
SA_API_TIMEOUT=15
