# 应用配置
APP_ENV=development
DEBUG=True

# 大模型配置
LLM__PROVIDER=openai
LLM__API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM__MODEL_NAME=gpt-4o-mini
LLM__TEMPERATURE=0.7

# Redis 配置
REDIS__URL=redis://localhost:6379/0
REDIS__MAX_CONNECTIONS=10

# Celery 配置
CELERY__BROKER_URL=redis://localhost:6379/1
CELERY__RESULT_BACKEND=redis://localhost:6379/1

# 上游 Strategy Agent 地址
STRATEGY_AGENT_BASE_URL=http://localhost:8001

# 下游 Knowledge Agent 地址
KNOWLEDGE_AGENT_BASE_URL=http://localhost:8002